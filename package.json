{
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "pnpm run build:icons && pnpm run build:ui",
		"build:icons": "pnpm --filter @sangyu-ui/icons build",
		"build:ui": "pnpm --filter sangyu-ui build",
		"release:icons": "pnpm --filter @sangyu-ui/icons publish --access public",
		"release:ui": "pnpm --filter sangyu-ui publish --access public",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "pnpm run typecheck:ui && pnpm run typecheck:icons && pnpm run typecheck:utils && pnpm run typecheck:config",
		"typecheck:ui": "vue-tsc --noEmit -p packages/sangyu-ui/tsconfig.json --pretty false",
		"typecheck:icons": "vue-tsc --noEmit -p packages/icons/tsconfig.json --pretty false",
		"typecheck:utils": "tsc --noEmit -p packages/utils/tsconfig.json --pretty false",
		"typecheck:config": "tsc --noEmit -p tsconfig.node.json --pretty false",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm docs:build",
		"test": "vitest",
		"test:run": "vitest run",
		"docs:dev": "vitepress dev",
		"docs:build": "vitepress build",
		"docs:preview": "vitepress preview",
		"genColors": "esno ./scripts/gen-colors.ts"
	},
	"dependencies": {
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@ant-design/colors": "^7.2.1",
		"@eslint/js": "^9.36.0",
		"@microsoft/api-extractor": "^7.58.12",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitejs/plugin-vue-jsx": "^5.1.2",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.8.1",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-define-config": "^2.1.0",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-vue": "^9.32.0",
		"esno": "^4.8.0",
		"globals": "^16.4.0",
		"jsdom": "^29.0.2",
		"less": "^4.4.2",
		"postcss": "^8.5.23",
		"prettier": "^3.6.2",
		"typescript": "~5.9.3",
		"unplugin-dts": "^1.0.3",
		"vite": "^7.2.2",
		"vite-plugin-tsx-resolve-types": "^0.0.7",
		"vite-plugin-vitepress-demo": "^2.2.1",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.4",
		"vue-eslint-parser": "^9.4.3",
		"vue-tsc": "^3.1.3"
	},
	"packageManager": "pnpm@10.18.3"
}
