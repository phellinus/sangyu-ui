{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
	"exclude": ["src/**/demos/**", "src/**/test/**", "src/**/__tests__/**", "src/**/*.test.ts"]
}
