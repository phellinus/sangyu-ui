{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"types": ["vite/client"],
		"jsxImportSource": "vue",
		"jsx": "preserve"
	},
	"include": ["src/**/*.vue", "src/**/*.ts"]
}
